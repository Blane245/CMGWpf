<Window x:Class="CMGWpf.Dialogs.Tools.ChordSequenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CMGWpf.Dialogs"
        Title="Chord Sequences" 
        xmlns:panels="clr-namespace:CMGWpf.Panels"
        xmlns:toolpanels="clr-namespace:CMGWpf.Panels.Tools"
        xmlns:services="clr-namespace:CMGWpf.Services"
        xmlns:layout="clr-namespace:CMGWpf.Layout"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:viewmodel="clr-namespace:CMGWpf.View"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=viewmodel:ChordSequenceView, IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
                WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Icon="/Assets/CMG-Logo.ico"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        d:DesignHeight="800" d:DesignWidth="1000"
        MinHeight="800" MinWidth="1000"
>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                           ResizeBorderThickness="5"
                           GlassFrameThickness="0"
                           CornerRadius="0"
                           UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="Black" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding Source={x:Static services:SizeService.Instance}, Path=ChromeHeight}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <panels:CustomWindowChrome Grid.Row="0"
                                       IconSource="/Assets/CMG-Logo.ico"
                                     WindowTitle="Chord Sequences Definitions"
                                   ChromeBackground="DarkCyan"
                                    />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1">
                    <StackPanel Margin="5">
                        <Label FontWeight="Bold" FontSize="14" Content="Chord Sequences" HorizontalAlignment="Center"/>
                        <Button Command="{Binding AddChordSequenceCommand}" Margin="0" Padding="0" Width="110">Add Chord Sequence</Button>
                        <DataGrid ItemsSource="{Binding ChordSequenceList}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="600">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" CanUserReorder="True" CanUserResize="True" CanUserSort="True"/>
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit" 
                                          Command="{Binding DataContext.EditChordSequenceCommand, 
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, 
                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Delete" 
                                          Command="{Binding DataContext.DeleteChordSequenceCommand, 
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, 
                                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <ContentControl Grid.Column="1" Content="{Binding EditorPanel}"/>
            </Grid>
            <Grid Grid.Row="3">
                <panels:MessagePanel Source="{Binding Errors}" Margin="0" MinHeight="150"/>
            </Grid>
        </Grid>
    </Border>
</Window>
