<Window x:Class="CMGWpf.Dialogs.PresetViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CMGWpf.Dialogs"
        xmlns:panels="clr-namespace:CMGWpf.Panels"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="CanResize"
        SizeToContent="WidthAndHeight"
        Icon="/Assets/CMG-Logo.ico"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        >
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                           ResizeBorderThickness="5"
                           GlassFrameThickness="0"
                           CornerRadius="0"
                           UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="Black" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <!-- window header -->
                <RowDefinition Height="Auto"/>
                <!-- preset list -->
                <RowDefinition Height="*"/>
                <!-- Cancel Button -->
            </Grid.RowDefinitions>
            <panels:CustomWindowChrome Grid.Row="0"
                                     WindowTitle="{Binding WindowTitle}"
                                     ChromeBackground="Chocolate">
            </panels:CustomWindowChrome>
            <ScrollViewer Grid.Row ="1" MaxHeight="500" Name="PresetList" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            </ScrollViewer>
            <Button Grid.Row="2" Content="Cancel" Click="Cancel_Click"  Margin="5" Width="75"/>
        </Grid>
    </Border>
</Window>
