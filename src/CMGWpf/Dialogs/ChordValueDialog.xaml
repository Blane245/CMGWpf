<Window x:Class="CMGWpf.Dialogs.ChordValueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CMGWpf.Dialogs"
        xmlns:panels="clr-namespace:CMGWpf.Panels"
        xmlns:services="clr-namespace:CMGWpf.Services"
        xmlns:viewmodel="clr-namespace:CMGWpf.View"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        d:DataContext="{d:DesignInstance Type=viewmodel:ChordSequenceView, IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
        Width="300" Height="100"
        Background="White"
        d:DesignHeight="250" d:DesignWidth="250"
                Icon="/Assets/CMG-Logo.ico"
        Title="New Chord Value"
        >
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                           ResizeBorderThickness="5"
                           GlassFrameThickness="0"
                           CornerRadius="0"
                           UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="Black" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding Source={x:Static services:SizeService.Instance}, Path=ChromeHeight}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <panels:CustomWindowChrome Grid.Row="0"
                                       IconSource="/Assets/CMG-Logo.ico"
                                     WindowTitle="New Chord Value"
                                   ChromeBackground="DarkCyan"
                                    />
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Label Content="New Chord Value: "/>
                <ComboBox ItemsSource="{Binding AllowedChords}" SelectedItem="{Binding NewChordValue, Mode=TwoWay}" Padding="5,0,0,0"  />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Content="OK" Command="{Binding NewChordValueCommand}" Margin="0"/>
                <Button Content="Cancel" Click="CancelButton_Click"/>
            </StackPanel>        
        </Grid>
    </Border>
</Window>
