<UserControl x:Class="CMGWpf.Panels.ChordSequencer.ChordSequencerAttributePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMGWpf.Panels.ChordSequencer"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:model="clr-namespace:CMGWpf.Model.Generators"
             xmlns:viewmodel="clr-namespace:CMGWpf.View"
             d:DataContext="{d:DesignInstance Type=viewmodel:GeneratorViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="800"
             >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="AttributeNameColumn"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="AlgorithmColumn"/>
            <ColumnDefinition Width="*" SharedSizeGroup="ParameterGroup"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="5">
            <Label Content="Chord Sequence" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.Row="0">
            <Button Content="Reload Sequences" Command="{Binding ReloadChordSequencesCommand}" Background="Green" Foreground="White"/>
            <ComboBox ItemsSource="{Binding ChordSequenceNames}"  SelectedItem="{Binding ChordSequenceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" MinWidth="100"/>
            <Button Content="Show Chord Sequence" Command="{Binding ShowChordSequenceCommand}" Background="Green" Foreground="White" Margin="5,0,0,0"/>
            <Label Content="Key: " Margin="5,0,0,0" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding NoteNames}" SelectedItem="{Binding ChordSequencerGenerator.Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" MinWidth="50"/>
            <Label Content="Octave: " Margin="5,0,0,0" VerticalAlignment="Center"/>
            <xctk:IntegerUpDown Value="{Binding ChordSequencerGenerator.Octave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" MinWidth="50" Minimum="-1" Maximum="9" Increment="1"/>
            <Label Content="Repeat Count: " Margin="5,0,0,0" VerticalAlignment="Center"/>
            <xctk:IntegerUpDown Value="{Binding ChordSequencerGenerator.Repeat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" MinWidth="50" Minimum="0" Maximum="100" Increment="1" ToolTip="0=repeat until stop time; >0=repeat the specified number of times"/>
        </StackPanel>
    </Grid>
</UserControl>
